---
import ClientApp from '../components/ClientApp';
import {
  allLocaleCodes,
  getHomeAlternateLinks,
  getLanguageSwitchPath,
  getTermAlternateLinks,
  localeMeta
} from '../i18n/catalog';
import '../index.css';
import '../coverTransition.css';
import '../loading.css';
import '../responsiveFixes.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  imagePath?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  translationKey?: string;
}

const {
  title,
  description,
  canonicalPath = '',
  imagePath = 'og-image.svg',
  imageAlt = 'The AI Almanac - an evolving field guide to artificial intelligence.',
  ogType = 'website',
  translationKey
} = Astro.props;

const base = import.meta.env.BASE_URL || '/';
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const absoluteUrl = (path: string) => Astro.site
  ? new URL(withBase(path), Astro.site).toString()
  : withBase(path);
const rootPath = withBase('');
const aboutPath = withBase('about/');
const canonicalUrl = absoluteUrl(canonicalPath);
const imageUrl = absoluteUrl(imagePath);
const isHome = canonicalPath === '';
const alternateLinks = isHome
  ? getHomeAlternateLinks()
  : translationKey
    ? getTermAlternateLinks(translationKey)
    : [];
const xDefault = alternateLinks.find((link) => link.locale === 'en');
const languageLinks = allLocaleCodes.map((code) => ({
  code,
  meta: localeMeta[code],
  href: withBase(getLanguageSwitchPath(code, translationKey))
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg?v=2')} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#17130f" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {alternateLinks.map((link) => (
      <link
        rel="alternate"
        hreflang={localeMeta[link.locale].htmlLang}
        href={absoluteUrl(link.path)}
      />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault.path)} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="The AI Almanac" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Baskervville:ital@0;1&family=Cinzel:wght@500;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      #root > astro-island {
        display: contents;
      }

      .site-language-switcher {
        position: fixed;
        right: 14px;
        bottom: 14px;
        z-index: 10020;
        font-family: 'Plus Jakarta Sans', sans-serif;
      }

      .site-language-switcher summary {
        list-style: none;
        cursor: pointer;
        min-width: 42px;
        padding: 8px 9px;
        border: 1px solid rgba(238, 222, 194, .55);
        background: rgba(35, 27, 21, .92);
        color: #f1e5cf;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .08em;
        text-align: center;
        box-shadow: 0 5px 18px rgba(0, 0, 0, .24);
      }

      .site-language-switcher summary::-webkit-details-marker {
        display: none;
      }

      .site-language-menu {
        position: absolute;
        right: 0;
        bottom: calc(100% + 7px);
        width: 178px;
        padding: 7px;
        border: 1px solid rgba(92, 69, 48, .55);
        background: #efe3cd;
        color: #2c2118;
        box-shadow: 0 14px 32px rgba(0, 0, 0, .28);
      }

      .site-language-menu a {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        padding: 8px 9px;
        color: inherit;
        text-decoration: none;
        font-size: 12px;
      }

      .site-language-menu a:hover,
      .site-language-menu a:focus-visible {
        background: rgba(80, 59, 40, .1);
      }

      .site-language-menu a[aria-current='true'] {
        font-weight: 700;
      }

      @media (max-width: 640px) {
        .site-language-switcher {
          right: 8px;
          bottom: 8px;
        }
      }
    </style>
  </head>
  <body>
    <script is:inline define:vars={{ rootPath, aboutPath }}>
      const normalizedPath = window.location.pathname.endsWith('/')
        ? window.location.pathname
        : `${window.location.pathname}/`;

      if (normalizedPath === aboutPath && !window.location.hash) {
        window.history.replaceState(
          window.history.state,
          '',
          `${rootPath}${window.location.search}#about`
        );
      }
    </script>

    <div id="root">
      <ClientApp client:only="react" />
    </div>

    <details class="site-language-switcher">
      <summary aria-label="Language">EN</summary>
      <nav class="site-language-menu" aria-label="Language">
        {languageLinks.map((link) => (
          <a
            href={link.href}
            hreflang={link.meta.htmlLang}
            lang={link.meta.htmlLang}
            aria-current={link.code === 'en' ? 'true' : undefined}
          >
            <span>{link.meta.nativeName}</span>
            <span>{link.meta.shortName}</span>
          </a>
        ))}
      </nav>
    </details>

    <script>
      import '../client/navigation';
    </script>
  </body>
</html>
