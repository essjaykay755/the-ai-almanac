---
import ClientApp from '../components/ClientApp';
import LocalizedClientApp from '../components/LocalizedClientApp';
import {
  getHomeAlternateLinks,
  getTermAlternateLinks,
  localeMeta,
  type LocalizedLocale,
  type SupportedLocale
} from '../i18n/catalog';
import '../index.css';
import '../coverTransition.css';
import '../loading.css';
import '../responsiveFixes.css';
import '../sidebarGuardRails.css';
import '../footerAlignment.css';
import '../mobileSidebarLayering.css';
import '../mobileContentSpacing.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  imagePath?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  translationKey?: string;
  locale?: SupportedLocale;
}

const {
  title,
  description,
  canonicalPath = '',
  imagePath = 'og-image.svg',
  imageAlt = 'The AI Almanac, an evolving field guide to artificial intelligence.',
  ogType = 'website',
  translationKey,
  locale = 'en'
} = Astro.props;

const currentMeta = localeMeta[locale];
const localizedLocale = locale === 'en' ? null : locale as LocalizedLocale;
const base = import.meta.env.BASE_URL || '/';
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const absoluteUrl = (path: string) => Astro.site
  ? new URL(withBase(path), Astro.site).toString()
  : withBase(path);
const rootPath = withBase('');
const aboutPath = withBase('about/');
const canonicalUrl = absoluteUrl(canonicalPath);
const imageUrl = absoluteUrl(imagePath);
const alternateLinks = translationKey ? getTermAlternateLinks(translationKey) : getHomeAlternateLinks();
const xDefault = alternateLinks.find((link) => link.locale === 'en');
const shouldBridgeAbout = locale === 'en';
---

<!doctype html>
<html lang={currentMeta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg?v=2')} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#17130f" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {alternateLinks.map((link) => (
      <link
        rel="alternate"
        hreflang={localeMeta[link.locale].htmlLang}
        href={absoluteUrl(link.path)}
      />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault.path)} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="The AI Almanac" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={currentMeta.ogLocale} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Baskervville:ital@0;1&family=Cinzel:wght@500;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      #root > astro-island {
        display: contents;
      }
    </style>
  </head>
  <body>
    {shouldBridgeAbout && (
      <script is:inline define:vars={{ rootPath, aboutPath }}>
        const normalizedPath = window.location.pathname.endsWith('/')
          ? window.location.pathname
          : `${window.location.pathname}/`;

        if (normalizedPath === aboutPath && !window.location.hash) {
          window.history.replaceState(
            window.history.state,
            '',
            `${rootPath}${window.location.search}#about`
          );
        }
      </script>
    )}

    <div id="root">
      {localizedLocale ? (
        <LocalizedClientApp locale={localizedLocale} initialTermKey={translationKey} client:only="react" />
      ) : (
        <ClientApp client:only="react" />
      )}
    </div>

    <div class="site-language-suggestion-host" data-language-suggestion-host></div>

    <script>
      import '../client/navigation';
    </script>
    <script>
      import '../client/languagePreference';
    </script>
  </body>
</html>
