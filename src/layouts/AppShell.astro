---
import ClientApp from '../components/ClientApp';
import LocalizedClientApp from '../components/LocalizedClientApp';
import {
  allLocaleCodes,
  getHomeAlternateLinks,
  getLanguageSwitchPath,
  getTermAlternateLinks,
  localeMeta,
  type LocalizedLocale,
  type SupportedLocale
} from '../i18n/catalog';
import '../index.css';
import '../coverTransition.css';
import '../loading.css';
import '../responsiveFixes.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  imagePath?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  translationKey?: string;
  locale?: SupportedLocale;
}

const {
  title,
  description,
  canonicalPath = '',
  imagePath = 'og-image.svg',
  imageAlt = 'The AI Almanac, an evolving field guide to artificial intelligence.',
  ogType = 'website',
  translationKey,
  locale = 'en'
} = Astro.props;

const currentMeta = localeMeta[locale];
const localizedLocale = locale === 'en' ? null : locale as LocalizedLocale;
const base = import.meta.env.BASE_URL || '/';
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const absoluteUrl = (path: string) => Astro.site
  ? new URL(withBase(path), Astro.site).toString()
  : withBase(path);
const rootPath = withBase('');
const aboutPath = withBase('about/');
const canonicalUrl = absoluteUrl(canonicalPath);
const imageUrl = absoluteUrl(imagePath);
const alternateLinks = translationKey ? getTermAlternateLinks(translationKey) : getHomeAlternateLinks();
const xDefault = alternateLinks.find((link) => link.locale === 'en');
const languageLinks = allLocaleCodes.map((code) => ({
  code,
  meta: localeMeta[code],
  href: withBase(getLanguageSwitchPath(code, translationKey))
}));
const shouldBridgeAbout = locale === 'en';
---

<!doctype html>
<html lang={currentMeta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg?v=2')} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#17130f" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {alternateLinks.map((link) => (
      <link
        rel="alternate"
        hreflang={localeMeta[link.locale].htmlLang}
        href={absoluteUrl(link.path)}
      />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault.path)} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="The AI Almanac" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={currentMeta.ogLocale} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Baskervville:ital@0;1&family=Cinzel:wght@500;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      #root > astro-island {
        display: contents;
      }

      .site-language-control {
        position: fixed;
        right: 14px;
        top: 14px;
        z-index: 10020;
        font-family: 'Plus Jakarta Sans', sans-serif;
      }

      .site-language-switcher {
        position: relative;
        margin-left: auto;
        width: fit-content;
      }

      .site-language-switcher summary {
        list-style: none;
        cursor: pointer;
        min-width: 46px;
        padding: 8px 10px;
        border: 1px solid rgba(238, 222, 194, .55);
        background: rgba(35, 27, 21, .92);
        color: #f1e5cf;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .08em;
        text-align: center;
        box-shadow: 0 5px 18px rgba(0, 0, 0, .24);
      }

      .site-language-switcher summary::-webkit-details-marker {
        display: none;
      }

      .site-language-menu {
        position: absolute;
        right: 0;
        top: calc(100% + 7px);
        width: 190px;
        padding: 7px;
        border: 1px solid rgba(92, 69, 48, .55);
        background: #efe3cd;
        color: #2c2118;
        box-shadow: 0 14px 32px rgba(0, 0, 0, .28);
      }

      .site-language-menu a {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        padding: 8px 9px;
        color: inherit;
        text-decoration: none;
        font-size: 12px;
      }

      .site-language-menu a:hover,
      .site-language-menu a:focus-visible {
        background: rgba(80, 59, 40, .1);
      }

      .site-language-menu a[aria-current='true'] {
        font-weight: 700;
      }

      .site-language-suggestion {
        position: relative;
        width: min(320px, calc(100vw - 28px));
        margin-top: 8px;
        padding: 14px 14px 12px;
        border: 1px solid rgba(92, 69, 48, .55);
        background: #efe3cd;
        color: #2c2118;
        box-shadow: 0 14px 32px rgba(0, 0, 0, .28);
      }

      .site-language-suggestion p {
        margin: 0;
        padding-right: 22px;
        font-size: 12px;
        line-height: 1.5;
      }

      .site-language-suggestion-close {
        position: absolute;
        top: 6px;
        right: 7px;
        width: 26px;
        height: 26px;
        border: 0;
        background: transparent;
        color: inherit;
        cursor: pointer;
        font: inherit;
        font-size: 18px;
        line-height: 1;
      }

      .site-language-suggestion-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 10px;
      }

      .site-language-suggestion-actions button {
        min-height: 34px;
        padding: 7px 10px;
        border: 1px solid rgba(70, 50, 34, .5);
        cursor: pointer;
        font: inherit;
        font-size: 11px;
        font-weight: 600;
      }

      .site-language-suggestion-primary {
        background: #34271d;
        color: #f6ead5;
      }

      .site-language-suggestion-secondary {
        background: transparent;
        color: #34271d;
      }

      @media (max-width: 640px) {
        .site-language-control {
          top: calc(8px + env(safe-area-inset-top));
          right: 8px;
        }
      }
    </style>
  </head>
  <body>
    {shouldBridgeAbout && (
      <script is:inline define:vars={{ rootPath, aboutPath }}>
        const normalizedPath = window.location.pathname.endsWith('/')
          ? window.location.pathname
          : `${window.location.pathname}/`;

        if (normalizedPath === aboutPath && !window.location.hash) {
          window.history.replaceState(
            window.history.state,
            '',
            `${rootPath}${window.location.search}#about`
          );
        }
      </script>
    )}

    <div id="root">
      {localizedLocale ? (
        <LocalizedClientApp locale={localizedLocale} initialTermKey={translationKey} client:only="react" />
      ) : (
        <ClientApp client:only="react" />
      )}
    </div>

    <div class="site-language-control" data-language-control>
      <details class="site-language-switcher">
        <summary aria-label={currentMeta.languageLabel}>{currentMeta.shortName} ▾</summary>
        <nav class="site-language-menu" aria-label={currentMeta.languageLabel}>
          {languageLinks.map((link) => (
            <a
              href={link.href}
              hreflang={link.meta.htmlLang}
              lang={link.meta.htmlLang}
              aria-current={link.code === locale ? 'true' : undefined}
              data-language-code={link.code}
            >
              <span>{link.meta.nativeName}</span>
              <span>{link.meta.shortName}</span>
            </a>
          ))}
        </nav>
      </details>
      <div data-language-suggestion-host></div>
    </div>

    <script>
      import '../client/navigation';
    </script>
    <script>
      import '../client/languagePreference';
    </script>
  </body>
</html>
