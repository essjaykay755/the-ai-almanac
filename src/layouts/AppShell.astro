---
import ClientApp from '../components/ClientApp';
import {
  allLocaleCodes,
  getHomeAlternateLinks,
  getLanguageSwitchPath,
  getLocalizedTermPath,
  getTermAlternateLinks,
  localeMeta
} from '../i18n/catalog';
import '../index.css';
import '../coverTransition.css';
import '../loading.css';
import '../responsiveFixes.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  imagePath?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  translationKey?: string;
}

const {
  title,
  description,
  canonicalPath = '',
  imagePath = 'og-image.svg',
  imageAlt = 'The AI Almanac - an evolving field guide to artificial intelligence.',
  ogType = 'website',
  translationKey
} = Astro.props;

const base = import.meta.env.BASE_URL || '/';
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const absoluteUrl = (path: string) => Astro.site
  ? new URL(withBase(path), Astro.site).toString()
  : withBase(path);
const rootPath = withBase('');
const aboutPath = withBase('about/');
const canonicalUrl = absoluteUrl(canonicalPath);
const imageUrl = absoluteUrl(imagePath);
const isHome = canonicalPath === '';
const alternateLinks = isHome
  ? getHomeAlternateLinks()
  : translationKey
    ? getTermAlternateLinks(translationKey)
    : [];
const xDefault = alternateLinks.find((link) => link.locale === 'en');
const languageLinks = allLocaleCodes.map((code) => ({
  code,
  meta: localeMeta[code],
  href: withBase(getLanguageSwitchPath(code, translationKey)),
  hasTranslation: code === 'en' || !translationKey || Boolean(getLocalizedTermPath(code, translationKey))
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg?v=2')} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#17130f" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {alternateLinks.map((link) => (
      <link
        rel="alternate"
        hreflang={localeMeta[link.locale].htmlLang}
        href={absoluteUrl(link.path)}
      />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault.path)} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="The AI Almanac" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Baskervville:ital@0;1&family=Cinzel:wght@500;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      #root > astro-island {
        display: contents;
      }

      .site-language-switcher {
        position: fixed;
        right: 14px;
        top: 14px;
        z-index: 10020;
        font-family: 'Plus Jakarta Sans', sans-serif;
      }

      .site-language-switcher summary {
        list-style: none;
        cursor: pointer;
        min-width: 46px;
        padding: 8px 10px;
        border: 1px solid rgba(238, 222, 194, .55);
        background: rgba(35, 27, 21, .92);
        color: #f1e5cf;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .08em;
        text-align: center;
        box-shadow: 0 5px 18px rgba(0, 0, 0, .24);
      }

      .site-language-switcher summary::-webkit-details-marker {
        display: none;
      }

      .site-language-menu {
        position: absolute;
        right: 0;
        top: calc(100% + 7px);
        width: 190px;
        padding: 7px;
        border: 1px solid rgba(92, 69, 48, .55);
        background: #efe3cd;
        color: #2c2118;
        box-shadow: 0 14px 32px rgba(0, 0, 0, .28);
      }

      .site-language-menu a {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        padding: 8px 9px;
        color: inherit;
        text-decoration: none;
        font-size: 12px;
      }

      .site-language-menu a:hover,
      .site-language-menu a:focus-visible {
        background: rgba(80, 59, 40, .1);
      }

      .site-language-menu a[aria-current='true'] {
        font-weight: 700;
      }

      .language-suggestion {
        position: fixed;
        right: 14px;
        top: 62px;
        z-index: 10019;
        width: min(340px, calc(100vw - 28px));
        padding: 15px 16px;
        border: 1px solid rgba(92, 69, 48, .55);
        background: #f2e7d3;
        color: #2c2118;
        box-shadow: 0 16px 38px rgba(0, 0, 0, .3);
        font-family: 'Plus Jakarta Sans', sans-serif;
      }

      .language-suggestion[hidden] {
        display: none;
      }

      .language-suggestion strong {
        display: block;
        margin-bottom: 5px;
        font-size: 13px;
      }

      .language-suggestion p {
        margin: 0;
        font-size: 12px;
        line-height: 1.5;
        color: #5d4b3b;
      }

      .language-suggestion-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
      }

      .language-suggestion-primary,
      .language-suggestion-dismiss {
        min-height: 34px;
        padding: 8px 10px;
        border: 1px solid #5f4936;
        font: inherit;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
      }

      .language-suggestion-primary {
        background: #2f241c;
        color: #f5ead6;
        text-decoration: none;
      }

      .language-suggestion-dismiss {
        background: transparent;
        color: #4e3d30;
      }

      .language-suggestion-note {
        margin-top: 9px !important;
        font-size: 10px !important;
        color: #7a6653 !important;
      }

      @media (max-width: 640px) {
        .site-language-switcher {
          right: 8px;
          top: 8px;
        }

        .language-suggestion {
          right: 8px;
          top: 56px;
          width: min(330px, calc(100vw - 16px));
        }
      }
    </style>
  </head>
  <body>
    <script is:inline define:vars={{ rootPath, aboutPath }}>
      const normalizedPath = window.location.pathname.endsWith('/')
        ? window.location.pathname
        : `${window.location.pathname}/`;

      if (normalizedPath === aboutPath && !window.location.hash) {
        window.history.replaceState(
          window.history.state,
          '',
          `${rootPath}${window.location.search}#about`
        );
      }
    </script>

    <div id="root">
      <ClientApp client:only="react" />
    </div>

    <details class="site-language-switcher">
      <summary aria-label="Language">EN</summary>
      <nav class="site-language-menu" aria-label="Language">
        {languageLinks.map((link) => (
          <a
            href={link.href}
            hreflang={link.meta.htmlLang}
            lang={link.meta.htmlLang}
            aria-current={link.code === 'en' ? 'true' : undefined}
            data-language-choice
            data-language-code={link.code}
            data-language-native={link.meta.nativeName}
            data-has-translation={link.hasTranslation ? 'true' : 'false'}
          >
            <span>{link.meta.nativeName}</span>
            <span>{link.meta.shortName}</span>
          </a>
        ))}
      </nav>
    </details>

    <aside class="language-suggestion" data-language-suggestion data-current-key={translationKey || ''} hidden>
      <strong data-language-suggestion-title></strong>
      <p data-language-suggestion-body></p>
      <div class="language-suggestion-actions">
        <a class="language-suggestion-primary" data-language-suggestion-link href="/"></a>
        <button class="language-suggestion-dismiss" type="button" data-language-suggestion-dismiss>Stay in English</button>
      </div>
      <p class="language-suggestion-note">Suggestion only. Your page never changes automatically.</p>
    </aside>

    <script>
      import '../client/navigation';
      import { getSuggestedLocale } from '../i18n/detection';

      const preferenceKey = 'aiAlmanacLanguage';
      const dismissedKey = 'aiAlmanacLanguageSuggestionDismissed';
      const choiceLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-language-choice]'));
      const suggestion = document.querySelector<HTMLElement>('[data-language-suggestion]');

      for (const link of choiceLinks) {
        link.addEventListener('click', () => {
          const code = link.dataset.languageCode;
          if (!code) return;
          try {
            localStorage.setItem(preferenceKey, code);
            localStorage.removeItem(dismissedKey);
          } catch {}
        });
      }

      async function getApproximateCountry(): Promise<string | null> {
        try {
          const response = await fetch('/api/geo', { headers: { accept: 'application/json' } });
          if (!response.ok) return null;
          const payload = await response.json() as { country?: unknown };
          return typeof payload.country === 'string' ? payload.country.toUpperCase() : null;
        } catch {
          return null;
        }
      }

      function getCountryName(countryCode: string | null): string | null {
        if (!countryCode) return null;
        try {
          return new Intl.DisplayNames(['en'], { type: 'region' }).of(countryCode) || countryCode;
        } catch {
          return countryCode;
        }
      }

      async function showLanguageSuggestion(): Promise<void> {
        if (!suggestion) return;

        try {
          if (localStorage.getItem(preferenceKey)) return;
        } catch {}

        const languages = navigator.languages?.length
          ? navigator.languages
          : navigator.language
            ? [navigator.language]
            : [];
        const country = await getApproximateCountry();
        const locale = getSuggestedLocale(languages, country);
        if (!locale) return;

        try {
          if (localStorage.getItem(dismissedKey) === locale) return;
        } catch {}

        const languageLink = choiceLinks.find((link) => link.dataset.languageCode === locale);
        if (!languageLink) return;

        const nativeName = languageLink.dataset.languageNative || locale.toUpperCase();
        const countryName = getCountryName(country);
        const hasTranslation = languageLink.dataset.hasTranslation === 'true';
        const currentKey = suggestion.dataset.currentKey || '';
        const primaryBrowserLanguage = languages[0]?.toLowerCase().split('-')[0] || '';
        const browserMatches = primaryBrowserLanguage === locale;
        const title = suggestion.querySelector<HTMLElement>('[data-language-suggestion-title]');
        const body = suggestion.querySelector<HTMLElement>('[data-language-suggestion-body]');
        const switchLink = suggestion.querySelector<HTMLAnchorElement>('[data-language-suggestion-link]');

        if (!title || !body || !switchLink) return;

        title.textContent = countryName ? `Visiting from ${countryName}?` : `${nativeName} available`;
        if (currentKey && hasTranslation) {
          body.textContent = browserMatches
            ? `Your browser prefers ${nativeName}. This entry is available in ${nativeName}.`
            : `This entry is also available in ${nativeName}.`;
        } else {
          body.textContent = browserMatches
            ? `Your browser prefers ${nativeName}. The AI Almanac has a ${nativeName} edition.`
            : `The AI Almanac is available in ${nativeName}.`;
        }

        switchLink.href = languageLink.href;
        switchLink.textContent = `View in ${nativeName}`;
        suggestion.dataset.suggestedLocale = locale;
        suggestion.hidden = false;
      }

      suggestion?.querySelector<HTMLButtonElement>('[data-language-suggestion-dismiss]')?.addEventListener('click', () => {
        const locale = suggestion.dataset.suggestedLocale;
        if (locale) {
          try {
            localStorage.setItem(dismissedKey, locale);
          } catch {}
        }
        suggestion.hidden = true;
      });

      suggestion?.querySelector<HTMLAnchorElement>('[data-language-suggestion-link]')?.addEventListener('click', () => {
        const locale = suggestion.dataset.suggestedLocale;
        if (!locale) return;
        try {
          localStorage.setItem(preferenceKey, locale);
          localStorage.removeItem(dismissedKey);
        } catch {}
      });

      void showLanguageSuggestion();
    </script>
  </body>
</html>
