---
import {
  allLocaleCodes,
  getHomeAlternateLinks,
  getLanguageSwitchPath,
  getTermAlternateLinks,
  localeMeta,
  type LocalizedLocale
} from '../i18n/catalog';

interface Props {
  locale: LocalizedLocale;
  title: string;
  description: string;
  canonicalPath: string;
  currentKey?: string;
}

const { locale, title, description, canonicalPath, currentKey } = Astro.props;
const meta = localeMeta[locale];
const base = import.meta.env.BASE_URL || '/';
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const absoluteUrl = (path: string) => Astro.site
  ? new URL(withBase(path), Astro.site).toString()
  : withBase(path);

const canonicalUrl = absoluteUrl(canonicalPath);
const imageUrl = absoluteUrl('og-image.svg');
const alternateLinks = currentKey ? getTermAlternateLinks(currentKey) : getHomeAlternateLinks();
const xDefault = alternateLinks.find((link) => link.locale === 'en');
const languageLinks = allLocaleCodes.map((code) => ({
  code,
  meta: localeMeta[code],
  href: withBase(getLanguageSwitchPath(code, currentKey))
}));
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg?v=2')} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#17130f" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {alternateLinks.map((link) => (
      <link
        rel="alternate"
        hreflang={localeMeta[link.locale].htmlLang}
        href={absoluteUrl(link.path)}
      />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={absoluteUrl(xDefault.path)} />}

    <meta property="og:type" content={currentKey ? 'article' : 'website'} />
    <meta property="og:site_name" content="The AI Almanac" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="The AI Almanac" />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Baskervville:ital@0;1&family=Cinzel:wght@500;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        color: #241b14;
        background: #17130f;
        font-family: 'Newsreader', Georgia, serif;
      }

      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; background: radial-gradient(circle at 50% 0%, #3a2a20 0, #211914 42%, #17130f 100%); }
      a { color: inherit; }

      .locale-shell { min-height: 100vh; padding: 28px 20px 56px; }
      .locale-page { width: min(1060px, 100%); margin: 0 auto; background: #f0e5d0; border: 1px solid rgba(75, 53, 35, .45); box-shadow: 0 30px 80px rgba(0, 0, 0, .34); }
      .locale-topbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 18px 24px; border-bottom: 1px solid rgba(80, 58, 39, .28); background: rgba(255, 250, 240, .42); }
      .locale-brand { font-family: 'Cinzel', serif; font-size: 16px; font-weight: 700; text-decoration: none; letter-spacing: .04em; }
      .locale-language { position: relative; }
      .locale-language summary { cursor: pointer; list-style: none; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; border: 1px solid rgba(76, 55, 37, .38); padding: 8px 10px; background: rgba(255, 255, 255, .35); }
      .locale-language summary::-webkit-details-marker { display: none; }
      .locale-language-menu { position: absolute; right: 0; top: calc(100% + 8px); z-index: 20; min-width: 180px; padding: 8px; background: #f4ead8; border: 1px solid rgba(76, 55, 37, .42); box-shadow: 0 14px 34px rgba(0, 0, 0, .2); }
      .locale-language-menu a { display: flex; justify-content: space-between; gap: 16px; padding: 9px 10px; text-decoration: none; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; }
      .locale-language-menu a:hover, .locale-language-menu a:focus-visible { background: rgba(78, 57, 39, .09); }
      .locale-language-menu a[aria-current='true'] { font-weight: 700; }
      .locale-content { padding: clamp(28px, 5vw, 64px); }

      @media (max-width: 640px) {
        .locale-shell { padding: 12px 8px 32px; }
        .locale-topbar { padding: 14px 16px; }
        .locale-content { padding: 28px 20px 36px; }
      }
    </style>
  </head>
  <body>
    <main class="locale-shell">
      <section class="locale-page">
        <header class="locale-topbar">
          <a class="locale-brand" href={withBase(locale === 'en' ? '' : `${locale}/`)}>The AI Almanac</a>
          <details class="locale-language">
            <summary aria-label={meta.languageLabel}>{meta.shortName}</summary>
            <nav class="locale-language-menu" aria-label={meta.languageLabel}>
              {languageLinks.map((link) => (
                <a
                  href={link.href}
                  hreflang={link.meta.htmlLang}
                  lang={link.meta.htmlLang}
                  aria-current={link.code === locale ? 'true' : undefined}
                >
                  <span>{link.meta.nativeName}</span>
                  <span>{link.meta.shortName}</span>
                </a>
              ))}
            </nav>
          </details>
        </header>
        <div class="locale-content">
          <slot />
        </div>
      </section>
    </main>
  </body>
</html>
