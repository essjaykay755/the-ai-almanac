---
import AppShell from '../../layouts/AppShell.astro';
import {
  localeMeta,
  localizedLocales,
  type LocalizedLocale
} from '../../i18n/catalog';

export function getStaticPaths() {
  return localizedLocales.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: LocalizedLocale;
}

const { lang } = Astro.props as Props;
const meta = localeMeta[lang];
---

<AppShell
  locale={lang}
  title={`${meta.homeHeading} | The AI Almanac`}
  description={meta.siteDescription}
  canonicalPath={`${lang}/`}
/>
