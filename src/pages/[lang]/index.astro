---
import LocalizedShell from '../../layouts/LocalizedShell.astro';
import {
  getLocalizedEntries,
  localeMeta,
  localizedLocales,
  type LocalizedLocale
} from '../../i18n/catalog';
import { getLocalizedSearchText, localizedSearchCopy } from '../../i18n/search';
import { getPublicPath } from '../../utils/ogImage';

export function getStaticPaths() {
  return localizedLocales.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: LocalizedLocale;
}

const { lang } = Astro.props as Props;
const meta = localeMeta[lang];
const entries = getLocalizedEntries(lang);
const searchCopy = localizedSearchCopy[lang];
const base = import.meta.env.BASE_URL || '/';
const entryHref = (slug: string) => getPublicPath(base, `${lang}/term/${slug}/`);
---

<LocalizedShell
  locale={lang}
  title={`${meta.homeHeading} | The AI Almanac`}
  description={meta.siteDescription}
  canonicalPath={`${lang}/`}
>
  <section class="locale-hero">
    <p class="locale-kicker">The AI Almanac</p>
    <h1>{meta.homeHeading}</h1>
    <p class="locale-intro">{meta.homeIntro}</p>
    <p class="locale-notice">{meta.translationNotice}</p>
  </section>

  <section class="locale-terms" aria-labelledby="translated-terms-heading">
    <div class="locale-section-heading">
      <h2 id="translated-terms-heading">{meta.availableTermsLabel}</h2>
      <span>{entries.length}</span>
    </div>

    <label class="locale-search">
      <span class="sr-only">{searchCopy.placeholder}</span>
      <input
        id="localeTermSearch"
        type="search"
        placeholder={searchCopy.placeholder}
        autocomplete="off"
        spellcheck="false"
      />
    </label>

    <div class="locale-term-grid" id="localeTermGrid">
      {entries.map((entry) => (
        <a
          class="locale-term-card"
          href={entryHref(entry.slug)}
          data-locale-term
          data-search={getLocalizedSearchText(lang, entry)}
        >
          <strong>{entry.word}</strong>
          <span>{entry.definition}</span>
        </a>
      ))}
    </div>
    <p class="locale-no-results" id="localeNoResults" hidden>{searchCopy.noResults}</p>
  </section>

  <style>
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
    .locale-hero { max-width: 780px; }
    .locale-kicker { margin: 0 0 12px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #79634d; }
    h1 { margin: 0; font-family: 'Cinzel', serif; font-size: clamp(34px, 7vw, 68px); line-height: 1.02; letter-spacing: -.025em; }
    .locale-intro { margin: 22px 0 0; max-width: 720px; font-size: clamp(20px, 2.6vw, 29px); line-height: 1.32; }
    .locale-notice { margin: 22px 0 0; padding-left: 14px; border-left: 2px solid #8d765d; color: #6b5846; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; line-height: 1.6; }
    .locale-terms { margin-top: 54px; }
    .locale-section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 12px; border-bottom: 1px solid rgba(77, 56, 38, .3); }
    .locale-section-heading h2 { margin: 0; font-family: 'Cinzel', serif; font-size: 20px; }
    .locale-section-heading span { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 12px; color: #79634d; }
    .locale-search { display: block; margin-top: 18px; }
    .locale-search input { width: 100%; padding: 13px 14px; border: 1px solid rgba(77, 56, 38, .34); background: rgba(255, 253, 247, .55); color: #33261d; font: 500 14px/1.3 'Plus Jakarta Sans', sans-serif; outline: none; }
    .locale-search input:focus { border-color: rgba(66, 45, 29, .75); box-shadow: 0 0 0 2px rgba(95, 73, 51, .1); }
    .locale-term-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 18px; }
    .locale-term-card { display: grid; gap: 8px; min-height: 150px; padding: 20px; text-decoration: none; border: 1px solid rgba(77, 56, 38, .26); background: rgba(255, 253, 247, .38); transition: transform 150ms ease, background 150ms ease; }
    .locale-term-card:hover, .locale-term-card:focus-visible { transform: translateY(-2px); background: rgba(255, 253, 247, .72); }
    .locale-term-card strong { font-family: 'Cinzel', serif; font-size: 18px; line-height: 1.2; }
    .locale-term-card span { color: #5f4f40; font-size: 16px; line-height: 1.42; }
    .locale-no-results { margin: 20px 0 0; color: #6b5846; font: 500 13px/1.6 'Plus Jakarta Sans', sans-serif; }

    @media (max-width: 680px) {
      .locale-term-grid { grid-template-columns: 1fr; }
      .locale-term-card { min-height: auto; }
      .locale-terms { margin-top: 38px; }
    }
  </style>

  <script>
    import { matchesLocalizedSearch } from '../../i18n/search';

    const searchInput = document.querySelector<HTMLInputElement>('#localeTermSearch');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-locale-term]'));
    const noResults = document.querySelector<HTMLElement>('#localeNoResults');

    searchInput?.addEventListener('input', () => {
      const query = searchInput.value;
      let visibleCount = 0;

      for (const card of cards) {
        const matches = matchesLocalizedSearch(card.dataset.search || '', query);
        card.hidden = !matches;
        if (matches) visibleCount += 1;
      }

      if (noResults) noResults.hidden = visibleCount !== 0;
    });
  </script>
</LocalizedShell>
