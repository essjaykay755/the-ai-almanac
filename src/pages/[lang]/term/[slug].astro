---
import LocalizedShell from '../../../layouts/LocalizedShell.astro';
import {
  getEnglishTermPath,
  getLocalizedEntries,
  getLocalizedTermPath,
  localeMeta,
  localizedLocales,
  type LocalizedEntry,
  type LocalizedLocale
} from '../../../i18n/catalog';
import { getPublicPath } from '../../../utils/ogImage';

export function getStaticPaths() {
  return localizedLocales.flatMap((lang) =>
    getLocalizedEntries(lang).map((entry) => ({
      params: { lang, slug: entry.slug },
      props: { lang, entry }
    }))
  );
}

interface Props {
  lang: LocalizedLocale;
  entry: LocalizedEntry;
}

const { lang, entry } = Astro.props as Props;
const meta = localeMeta[lang];
const base = import.meta.env.BASE_URL || '/';
const canonicalPath = getLocalizedTermPath(lang, entry.key) || `${lang}/`;
const homeHref = getPublicPath(base, `${lang}/`);
const englishHref = getPublicPath(base, getEnglishTermPath(entry.key));
const moreEntries = getLocalizedEntries(lang).filter((item) => item.key !== entry.key).slice(0, 4);
---

<LocalizedShell
  locale={lang}
  title={`${entry.word} - The AI Almanac`}
  description={entry.definition}
  canonicalPath={canonicalPath}
  currentKey={entry.key}
>
  <article class="localized-entry">
    <a class="localized-back" href={homeHref}>← {meta.homeLinkLabel}</a>

    <div class="localized-headword">
      <p class="localized-kicker">The AI Almanac</p>
      <h1>{entry.word}</h1>
      <p class="localized-english"><span>{meta.englishLabel}:</span> {entry.key}</p>
    </div>

    <section class="localized-definition">
      <h2>{meta.definitionLabel}</h2>
      <p>{entry.definition}</p>
    </section>

    <section class="localized-note">
      <h2>{meta.noteLabel}</h2>
      <p>{entry.note}</p>
    </section>

    <div class="localized-actions">
      <a class="localized-primary" href={englishHref}>{meta.openEnglishLabel}</a>
    </div>

    <aside class="localized-more">
      <h2>{meta.availableTermsLabel}</h2>
      <div class="localized-more-grid">
        {moreEntries.map((item) => (
          <a href={getPublicPath(base, `${lang}/term/${item.slug}/`)}>{item.word}</a>
        ))}
      </div>
    </aside>
  </article>

  <style>
    .localized-entry { max-width: 820px; }
    .localized-back { display: inline-block; margin-bottom: 34px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 600; text-decoration: none; color: #6d5946; }
    .localized-kicker { margin: 0 0 10px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: #7b654f; }
    h1 { margin: 0; font-family: 'Cinzel', serif; font-size: clamp(38px, 7vw, 70px); line-height: 1.04; letter-spacing: -.025em; overflow-wrap: anywhere; }
    .localized-english { margin: 14px 0 0; font-size: 17px; color: #6d5946; }
    .localized-english span { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    .localized-definition { margin-top: 48px; padding-top: 24px; border-top: 1px solid rgba(79, 57, 39, .3); }
    .localized-definition h2, .localized-note h2, .localized-more h2 { margin: 0 0 12px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #75604b; }
    .localized-definition p { margin: 0; font-size: clamp(22px, 3vw, 32px); line-height: 1.38; }
    .localized-note { margin-top: 34px; padding: 20px 22px; background: rgba(130, 98, 66, .08); border-left: 3px solid #846a51; }
    .localized-note p { margin: 0; font-size: 18px; line-height: 1.55; }
    .localized-actions { margin-top: 34px; }
    .localized-primary { display: inline-block; padding: 12px 16px; border: 1px solid #5f4936; text-decoration: none; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 700; background: #2f241c; color: #f5ead6; }
    .localized-more { margin-top: 58px; padding-top: 24px; border-top: 1px solid rgba(79, 57, 39, .3); }
    .localized-more-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .localized-more-grid a { padding: 12px 14px; border: 1px solid rgba(79, 57, 39, .22); text-decoration: none; font-size: 17px; background: rgba(255, 253, 247, .32); }

    @media (max-width: 620px) {
      .localized-back { margin-bottom: 24px; }
      .localized-definition { margin-top: 34px; }
      .localized-more-grid { grid-template-columns: 1fr; }
    }
  </style>
</LocalizedShell>
