---
import AppShell from '../../../layouts/AppShell.astro';
import {
  getLocalizedEntries,
  getLocalizedTermPath,
  localizedLocales,
  type LocalizedEntry,
  type LocalizedLocale
} from '../../../i18n/catalog';

export function getStaticPaths() {
  return localizedLocales.flatMap((lang) =>
    getLocalizedEntries(lang).map((entry) => ({
      params: { lang, slug: entry.slug },
      props: { lang, entry }
    }))
  );
}

interface Props {
  lang: LocalizedLocale;
  entry: LocalizedEntry;
}

const { lang, entry } = Astro.props as Props;
const canonicalPath = getLocalizedTermPath(lang, entry.key) || `${lang}/`;
---

<AppShell
  locale={lang}
  title={`${entry.word} - The AI Almanac`}
  description={entry.definition}
  canonicalPath={canonicalPath}
  ogType="article"
  translationKey={entry.key}
/>
